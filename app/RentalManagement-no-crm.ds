/*
 * Rental Management - Zoho Creator application
 * Portfolio project by Gonzalo de Andrade
 * Built from app/src/RentalManagement.template.ds by app/build.mjs
 */
 application "Rental Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Argentina/Buenos_Aires"
 	time format = "24-hr"
 	forms
	{
		form Customers
		{
			displayname = "Customer"
			success message = "Customer saved successfully."
			field alignment = left
			Customer_Section
			(
				type = section
				displayname = "Customer Details"
	 			row = 1
	 			column = 0
				width = medium
			)
			must have Customer_Name
			(
    			type = text
				displayname = "Customer Name"
				maxchar = 100
	 			row = 1
	 			column = 1
				width = medium
			)
			must have unique Email
			(
    			type = email
				displayname = "Email"
				maxchar = 100
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Phone
			(
    			type = phonenumber
				displayname = "Phone"
	 			row = 1
	 			column = 1
				width = medium
			)
			must have unique ID_Reference
			(
    			type = text
				displayname = "Identification Reference"
				maxchar = 30
    			description
    			[
    				type = help_text
    			 	message = "Internal ID reference (fictional data only), e.g. CUS-ID-1001."
    			]
	 			row = 1
	 			column = 1
				width = medium
			)

			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Customer"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Properties
		{
			displayname = "Property"
			success message = "Property saved successfully."
			field alignment = left
			Property_Section
			(
				type = section
				displayname = "Property Details"
	 			row = 1
	 			column = 0
				width = medium
			)
			must have unique Property_Name
			(
    			type = text
				displayname = "Property Name / Reference"
				maxchar = 100
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Address
			(
    			type = address
				displayname = "Address"
     			capture_coordinates = false
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			)
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			)
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			)
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			)
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			)
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			)
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			)
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			)
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Property_Type
			(
				type = picklist
				displayname = "Property Type"
				values = {"Apartment","House","Studio","Loft","Cabin"}
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Daily_Rate
			(
				displayname = "Daily Rental Rate"
				type = USD
				format = commadotwestern
				initial value = 0.00
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Availability_Status
			(
				type = picklist
				displayname = "Availability Status"
				values = {"Available","Rented","Maintenance"}
				initial value = "Available"
    			description
    			[
    				type = help_text
    			 	message = "Set automatically to Rented / Available by active rentals. Set Maintenance manually to block new bookings."
    			]
	 			row = 1
	 			column = 1
				width = medium
			)
			Description
			(
    			type = textarea
				displayname = "Description"
	 			row = 1
	 			column = 1
				width = medium
			)

			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Property"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Rentals
		{
			displayname = "Rental"
			success message = "Rental saved successfully."
			field alignment = left
			Rental_Section
			(
				type = section
				displayname = "Rental Details"
	 			row = 1
	 			column = 0
				width = medium
			)
			Rental_No
			(
				type = autonumber
				displayname = "Rental No."
				start index = 1
	 			row = 1
	 			column = 1
				width = medium
			)
			Rental_Reference
			(
    			type = text
				displayname = "Rental Reference"
				maxchar = 20
    			description
    			[
    				type = help_text
    			 	message = "Generated automatically after saving (RNT-0001)."
    			]
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Customer
			(
				type = picklist
				displayname = "Customer"
				values  = Customers.ID
    			displayformat = [Customer_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Property
			(
				type = picklist
				displayname = "Property"
				values  = Properties.ID
    			displayformat = [Property_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1
				width = medium
			)
			must have Start_Date
			(
    			type = date
				displayname = "Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1
				width = medium
			)
			must have End_Date
			(
    			type = date
				displayname = "End Date"
				alloweddays = 0,1,2,3,4,5,6
    			description
    			[
    				type = help_text
    			 	message = "Check-out date. Must be later than the start date."
    			]
	 			row = 1
	 			column = 1
				width = medium
			)
			Number_of_Days
			(
				type = number
				displayname = "Number of Days"
				initial value = 0
	 			row = 1
	 			column = 2
				width = medium
			)
			Daily_Rate
			(
				displayname = "Daily Rate"
				type = USD
				format = commadotwestern
				initial value = 0.00
    			description
    			[
    				type = help_text
    			 	message = "Copied from the property when the rental is created."
    			]
	 			row = 1
	 			column = 2
				width = medium
			)
			Total_Cost
			(
				displayname = "Total Cost"
				type = USD
				format = commadotwestern
				initial value = 0.00
    			description
    			[
    				type = help_text
    			 	message = "Calculated automatically: Number of Days x Daily Rate."
    			]
	 			row = 1
	 			column = 2
				width = medium
			)
			must have Rental_Status
			(
				type = picklist
				displayname = "Rental Status"
				values = {"Reserved","Active","Completed","Cancelled"}
				initial value = "Reserved"
	 			row = 1
	 			column = 2
				width = medium
			)
			Notes
			(
    			type = textarea
				displayname = "Notes"
	 			row = 1
	 			column = 2
				width = medium
			)
			CRM_Deal_ID
			(
    			type = text
				displayname = "CRM Deal ID"
				maxchar = 30
    			description
    			[
    				type = help_text
    			 	message = "Filled automatically when the rental is synced to Zoho CRM as a Deal."
    			]
	 			row = 1
	 			column = 2
				width = medium
			)
			Books_Invoice_No
			(
    			type = text
				displayname = "Invoice No."
				maxchar = 30
    			description
    			[
    				type = help_text
    			 	message = "Zoho Books invoice, created automatically when the rental is completed."
    			]
	 			row = 1
	 			column = 2
				width = medium
			)

			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Save Rental"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Customers
		{
			displayName = "Customers"
			show all rows from Customers
			(
				Customer_Name as "Customer Name"
				Email as "Email"
				Phone as "Phone"
				ID_Reference as "Identification Reference"
			)
			sort by
			(
				Customer_Name ascending
			)
		}
		default list All_Properties
		{
			displayName = "All Properties"
			show all rows from Properties
			(
				Property_Name as "Property"
				Property_Type as "Type"
				Address as "Address"
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+state_province+""+postal_Code+""+country]
	 			)
				Daily_Rate as "Daily Rate"
				Availability_Status as "Availability"
				Description as "Description"
			)
			sort by
			(
				Property_Name ascending
			)
			conditional formatting
			(
				"Available"
				{
				condition = (Availability_Status == "Available")
				fields = [Availability_Status]
				format = "color:#0b6b3a;background-color:#d9f2e3;"
				}
				"Rented"
				{
				condition = (Availability_Status == "Rented")
				fields = [Availability_Status]
				format = "color:#1d4f91;background-color:#dde8f8;"
				}
				"Maintenance"
				{
				condition = (Availability_Status == "Maintenance")
				fields = [Availability_Status]
				format = "color:#8a4b00;background-color:#fbe9d0;"
				}
			)
		}
		list Available_Properties
		{
			displayName = "Available Properties"
			show all rows from Properties [Availability_Status == "Available"]
			(
				Property_Name as "Property"
				Property_Type as "Type"
				Address as "Address"
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+state_province+""+postal_Code+""+country]
	 			)
				Daily_Rate as "Daily Rate"
				Description as "Description"
			)
			sort by
			(
				Daily_Rate ascending
			)
		}
		default list All_Rentals
		{
			displayName = "All Rentals"
			show all rows from Rentals
			(
				Rental_Reference as "Reference"
				Customer as "Customer"
				Property as "Property"
				Start_Date as "Start Date"
				End_Date as "End Date"
				Number_of_Days as "Days"
				Daily_Rate as "Daily Rate"
				Total_Cost as "Total Cost"
				Rental_Status as "Status"
				Notes as "Notes"
			)
			sort by
			(
				Start_Date descending
			)
			conditional formatting
			(
				"Reserved"
				{
				condition = (Rental_Status == "Reserved")
				fields = [Rental_Status]
				format = "color:#5b3cc4;background-color:#ece7ff;"
				}
				"Active"
				{
				condition = (Rental_Status == "Active")
				fields = [Rental_Status]
				format = "color:#1d4f91;background-color:#dde8f8;"
				}
				"Completed"
				{
				condition = (Rental_Status == "Completed")
				fields = [Rental_Status]
				format = "color:#0b6b3a;background-color:#d9f2e3;"
				}
				"Cancelled"
				{
				condition = (Rental_Status == "Cancelled")
				fields = [Rental_Status]
				format = "color:#6b6b6b;background-color:#ececec;"
				}
			)
		}
		list Active_Rentals
		{
			displayName = "Active Rentals"
			show all rows from Rentals [Rental_Status == "Active"]
			(
				Rental_Reference as "Reference"
				Customer as "Customer"
				Property as "Property"
				Start_Date as "Start Date"
				End_Date as "End Date"
				Number_of_Days as "Days"
				Total_Cost as "Total Cost"
				Rental_Status as "Status"
			)
			sort by
			(
				End_Date ascending
			)
		}
		list Upcoming_Rentals
		{
			displayName = "Upcoming Rentals"
			show all rows from Rentals [Rental_Status == "Reserved"]
			(
				Rental_Reference as "Reference"
				Customer as "Customer"
				Property as "Property"
				Start_Date as "Start Date"
				End_Date as "End Date"
				Number_of_Days as "Days"
				Total_Cost as "Total Cost"
				Rental_Status as "Status"
			)
			sort by
			(
				Start_Date ascending
			)
		}
		list Completed_Rentals
		{
			displayName = "Completed Rentals"
			show all rows from Rentals [Rental_Status == "Completed"]
			(
				Rental_Reference as "Reference"
				Customer as "Customer"
				Property as "Property"
				Start_Date as "Start Date"
				End_Date as "End Date"
				Number_of_Days as "Days"
				Daily_Rate as "Daily Rate"
				Total_Cost as "Total Cost"
			)
			sort by
			(
				End_Date descending
			)
		}
	}
	pages
	{
		page Dashboard
		{
			displayname = "Dashboard"
			Content="<zml \n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width=\"25%\"\n   \t>\n\t<panel elementName=\"Panel\"\n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tparameters = '#Report:Active_Rentals' \n\t\tcomponentLinkName = 'Active_Rentals'\n\t\ttarget = 'popup'\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '5px'\n\tcolor = '#2A70E7'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\tbgColor = '#FFFFFF'\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\t  \n\t\tcriteria = 'Rental_Status == &quot;Active&quot;'\n\t  value = 'thisapp.Rentals.ID.count'\n>\n<\/text>\n\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr><pr \n\t\t\twidth='fill'\n\t\theight='50px'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#2A70E7'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '20px'\n\tmarginRight = '20px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\t  \n\t  value = 'Active Rentals'\n>\n<\/text>\n\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/panel>\n<\/column><column\n   \t\t width=\"25%\"\n   \t>\n\t<panel elementName=\"Panel 1\"\n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tparameters = '#Report:Upcoming_Rentals' \n\t\tcomponentLinkName = 'Upcoming_Rentals'\n\t\ttarget = 'popup'\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '5px'\n\tcolor = '#7B61FF'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\tbgColor = '#FFFFFF'\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\t  \n\t\tcriteria = 'Rental_Status == &quot;Reserved&quot;'\n\t  value = 'thisapp.Rentals.ID.count'\n>\n<\/text>\n\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr><pr \n\t\t\twidth='fill'\n\t\theight='50px'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#7B61FF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '20px'\n\tmarginRight = '20px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\t  \n\t  value = 'Upcoming Rentals'\n>\n<\/text>\n\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/panel>\n<\/column><column\n   \t\t width=\"25%\"\n   \t>\n\t<panel elementName=\"Panel 2\"\n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tparameters = '#Report:Available_Properties' \n\t\tcomponentLinkName = 'Available_Properties'\n\t\ttarget = 'popup'\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '5px'\n\tcolor = '#0A9F4B'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\tbgColor = '#FFFFFF'\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\t  \n\t\tcriteria = 'Availability_Status == &quot;Available&quot;'\n\t  value = 'thisapp.Properties.ID.count'\n>\n<\/text>\n\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr><pr \n\t\t\twidth='fill'\n\t\theight='50px'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#0A9F4B'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '20px'\n\tmarginRight = '20px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\t  \n\t  value = 'Available Properties'\n>\n<\/text>\n\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/panel>\n<\/column><column\n   \t\t width=\"25%\"\n   \t>\n\t<panel elementName=\"Panel 3\"\n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tparameters = '#Report:All_Customers' \n\t\tcomponentLinkName = 'All_Customers'\n\t\ttarget = 'popup'\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '5px'\n\tcolor = '#E8710A'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\tbgColor = '#FFFFFF'\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\t  \n\t  value = 'thisapp.Customers.ID.count'\n>\n<\/text>\n\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr><pr \n\t\t\twidth='fill'\n\t\theight='50px'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#E8710A'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '20px'\n\tmarginRight = '20px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\t  \n\t  value = 'Customers'\n>\n<\/text>\n\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/panel>\n<\/column>\n<\/row><row>\n\t<column\n   \t\t width=\"50%\"\n   \t>\n\t<panel elementName=\"Panel 4\"\n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tparameters = '#Report:Completed_Rentals' \n\t\tcomponentLinkName = 'Completed_Rentals'\n\t\ttarget = 'popup'\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '5px'\n\tcolor = '#1F2D3D'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\tbgColor = '#FFFFFF'\n\n\tdisplayType = 'actual'\n\tdecimalPlaces = '2'\n\tthousandsSeperator = 'COMMA'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\t  \n\t\tcriteria = 'Rental_Status == &quot;Completed&quot;'\n\t  value = 'thisapp.Rentals.Total_Cost.sum'\n>\n<\/text>\n\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr><pr \n\t\t\twidth='fill'\n\t\theight='50px'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#1F2D3D'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '20px'\n\tmarginRight = '20px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\t  \n\t  value = 'Realized Revenue (USD) - Completed rentals'\n>\n<\/text>\n\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/panel>\n<\/column><column\n   \t\t width=\"50%\"\n   \t>\n\t<panel elementName=\"Panel 5\"\n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n    action = 'OpenReport'\n\t\tparameters = '#Report:All_Rentals' \n\t\tcomponentLinkName = 'All_Rentals'\n\t\ttarget = 'popup'\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '5px'\n\tcolor = '#0E8A94'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\tbgColor = '#FFFFFF'\n\n\tdisplayType = 'actual'\n\tdecimalPlaces = '2'\n\tthousandsSeperator = 'COMMA'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\t  \n\t\tcriteria = 'Rental_Status == &quot;Reserved&quot; || Rental_Status == &quot;Active&quot;'\n\t  value = 'thisapp.Rentals.Total_Cost.sum'\n>\n<\/text>\n\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr><pr \n\t\t\twidth='fill'\n\t\theight='50px'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#0E8A94'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '20px'\n\tmarginRight = '20px' \n\tmarginBottom = '0px'\n\tmarginTop = '0px'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\t  \n\t  value = 'Booked Revenue (USD) - Reserved + Active'\n>\n<\/text>\n\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/pc>\n<\/pr>\n<\/panel>\n<\/column>\n<\/row>\n<\/layout>\n<\/zml>"
		}
	}
		 functions
		 {
			 Deluge
			 {
				 map RentalLogic.calculate(date startDate, date endDate, decimal dailyRate)
         {
         	// Single source of truth for duration and price.
         	// Days = nights between start and end (end date is the check-out day).
         	result = Map();
         	days = 0;
         	if(startDate != null && endDate != null && endDate > startDate)
         	{
         		days = startDate.daysBetween(endDate);
         	}
         	rate = ifnull(dailyRate,0);
         	result.put("days",days);
         	result.put("total",(days * rate).round(2));
         	return result;
         }
			 }
		 }

		workflow
		{
		form
		{
			Rental_Field_Setup as "Rental - Field setup"
			{
				type =  form
				form = Rentals
				record event = on add or edit

				on load
				{
					actions
					{
						custom deluge script
						(
							disable Rental_Reference;
							disable Number_of_Days;
							disable Daily_Rate;
							disable Total_Cost;
							disable CRM_Deal_ID;
							disable Books_Invoice_No;
							if(input.Rental_Reference == null || input.Rental_Reference == "")
							{
								hide Rental_Reference;
							}
							if(input.CRM_Deal_ID == null || input.CRM_Deal_ID == "")
							{
								hide CRM_Deal_ID;
							}
							if(input.Books_Invoice_No == null || input.Books_Invoice_No == "")
							{
								hide Books_Invoice_No;
							}
						)
					}
				}

			}
			Rental_Property_Selected as "Rental - Property selected"
			{
				type =  form
				form = Rentals
				record event = on add or edit

				on user input of Property
				{
					actions
					{
						custom deluge script
						(
							if(input.Property != null)
							{
								prop = Properties[ID == input.Property];
								input.Daily_Rate = prop.Daily_Rate;
							}
							else
							{
								input.Daily_Rate = 0;
							}
							calc = thisapp.RentalLogic.calculate(input.Start_Date,input.End_Date,input.Daily_Rate);
							input.Number_of_Days = calc.get("days");
							input.Total_Cost = calc.get("total");
						)
					}
				}

			}
			Rental_Start_Date_Changed as "Rental - Start date changed"
			{
				type =  form
				form = Rentals
				record event = on add or edit

				on user input of Start_Date
				{
					actions
					{
						custom deluge script
						(
							calc = thisapp.RentalLogic.calculate(input.Start_Date,input.End_Date,input.Daily_Rate);
							input.Number_of_Days = calc.get("days");
							input.Total_Cost = calc.get("total");
						)
					}
				}

			}
			Rental_End_Date_Changed as "Rental - End date changed"
			{
				type =  form
				form = Rentals
				record event = on add or edit

				on user input of End_Date
				{
					actions
					{
						custom deluge script
						(
							calc = thisapp.RentalLogic.calculate(input.Start_Date,input.End_Date,input.Daily_Rate);
							input.Number_of_Days = calc.get("days");
							input.Total_Cost = calc.get("total");
						)
					}
				}

			}
			Rental_Validation as "Rental - Validate and calculate"
			{
				type =  form
				form = Rentals
				record event = on add or edit

				on validate
				{
					actions
					{
						custom deluge script
						(
							// Rentals - On Validate (add and edit).
							// Server-side source of truth: every rule below runs on each save, so values
							// typed in the browser or sent through the API cannot bypass it.
							errors = List();
							today = zoho.currentdate;
							currentId = ifnull(input.ID,0);
							oldRec = Rentals[ID == currentId];
							isNew = oldRec.count() == 0;
							oldStatus = "";
							if(!isNew)
							{
								oldStatus = oldRec.Rental_Status;
							}
							newStatus = ifnull(input.Rental_Status,"");
							// R1 - Required fields (also enforced by the form's mandatory flags)
							if(input.Customer == null)
							{
								errors.add("Customer is required.");
							}
							if(input.Property == null)
							{
								errors.add("Property is required.");
							}
							if(input.Start_Date == null)
							{
								errors.add("Start date is required.");
							}
							if(input.End_Date == null)
							{
								errors.add("End date is required.");
							}
							if(newStatus == "")
							{
								errors.add("Rental status is required.");
							}
							// R2 - Lookups must point to existing records
							if(input.Customer != null)
							{
								if(Customers[ID == input.Customer].count() == 0)
								{
									errors.add("The selected customer does not exist.");
								}
							}
							propertyName = "";
							propertyStatus = "";
							propertyRate = 0;
							if(input.Property != null)
							{
								prop = Properties[ID == input.Property];
								if(prop.count() == 0)
								{
									errors.add("The selected property does not exist.");
								}
								else
								{
									propertyName = prop.Property_Name;
									propertyStatus = prop.Availability_Status;
									propertyRate = prop.Daily_Rate;
								}
							}
							// R3 - Date range
							if(input.Start_Date != null && input.End_Date != null)
							{
								if(input.End_Date <= input.Start_Date)
								{
									errors.add("End date must be later than the start date.");
								}
								else if(input.Start_Date.daysBetween(input.End_Date) > 365)
								{
									errors.add("A rental cannot be longer than 365 days.");
								}
							}
							// R4 - Status rules
							propertyChanged = true;
							if(isNew)
							{
								if(newStatus == "Cancelled")
								{
									errors.add("A new rental cannot be created as Cancelled.");
								}
								if(newStatus == "Reserved" && input.Start_Date != null)
								{
									if(input.Start_Date < today)
									{
										errors.add("A reservation cannot start in the past. Record past rentals as Active or Completed.");
									}
								}
							}
							else
							{
								propertyChanged = input.Property != oldRec.Property;
								allowed = Map();
								allowed.put("Reserved",{"Reserved","Active","Cancelled"});
								allowed.put("Active",{"Active","Completed"});
								allowed.put("Completed",{"Completed"});
								allowed.put("Cancelled",{"Cancelled"});
								nextStatuses = allowed.get(oldStatus);
								if(nextStatuses != null)
								{
									if(!nextStatuses.contains(newStatus))
									{
										errors.add("Invalid status change: " + oldStatus + " to " + newStatus + ". Allowed: Reserved to Active or Cancelled, Active to Completed. Completed and Cancelled are final.");
									}
								}
								if(oldStatus == "Completed" || oldStatus == "Cancelled")
								{
									if(input.Customer != oldRec.Customer || input.Property != oldRec.Property || input.Start_Date != oldRec.Start_Date || input.End_Date != oldRec.End_Date)
									{
										errors.add(oldStatus + " rentals are locked. Only the notes can be edited.");
									}
								}
								else if(oldStatus == "Active")
								{
									if(input.Customer != oldRec.Customer || input.Property != oldRec.Property || input.Start_Date != oldRec.Start_Date)
									{
										errors.add("The customer, property and start date of an active rental cannot be changed.");
									}
								}
							}
							if((isNew || newStatus != oldStatus) && input.Start_Date != null && input.End_Date != null)
							{
								if(newStatus == "Active" && input.Start_Date > today)
								{
									errors.add("A rental can only be Active once its start date (" + input.Start_Date.toString("dd-MMM-yyyy") + ") has been reached.");
								}
								if(newStatus == "Completed" && input.End_Date > today)
								{
									errors.add("A rental can only be Completed on or after its end date. To finish early, set the end date to today first.");
								}
							}
							// R5 - Properties under maintenance cannot take new bookings
							if(propertyChanged && propertyStatus == "Maintenance" && (newStatus == "Reserved" || newStatus == "Active"))
							{
								errors.add("Property " + propertyName + " is under maintenance and cannot be booked.");
							}
							// R6 - No overlapping bookings for the same property.
							// Half-open ranges [start, end): a new rental may start on another rental's end date.
							if(errors.isEmpty() && newStatus != "Cancelled")
							{
								clashes = Rentals[Property == input.Property && ID != currentId && Rental_Status != "Cancelled" && Start_Date < input.End_Date && End_Date > input.Start_Date] sort by Start_Date;
								if(clashes.count() > 0)
								{
									errors.add("Booking overlap: " + propertyName + " is already booked from " + clashes.Start_Date.toString("dd-MMM-yyyy") + " to " + clashes.End_Date.toString("dd-MMM-yyyy") + " (" + clashes.Rental_Reference + ", " + clashes.Rental_Status + ").");
								}
							}
							if(errors.size() > 0)
							{
								alert errors.toString("\n");
								cancel submit;
							}
							else
							{
								// C1 - Daily rate is a snapshot: taken from the property on create or when the
								// property changes, otherwise kept from the saved record.
								rate = propertyRate;
								if(!propertyChanged)
								{
									rate = oldRec.Daily_Rate;
								}
								input.Daily_Rate = rate;
								calc = thisapp.RentalLogic.calculate(input.Start_Date,input.End_Date,input.Daily_Rate);
								input.Number_of_Days = calc.get("days");
								input.Total_Cost = calc.get("total");
							}
						)
					}
				}

			}
			Rental_After_Save as "Rental - Reference and property status"
			{
				type =  form
				form = Rentals
				record event = on add or edit

				on success
				{
					actions
					{
						custom deluge script
						(
							// Rentals - On Success (add and edit).
							// Human-readable reference, generated once from the autonumber: RNT-0001.
							// No reference yet = first save, i.e. a new booking.
							isNewBooking = input.Rental_Reference == null || input.Rental_Reference == "";
							if(isNewBooking)
							{
								input.Rental_Reference = "RNT-" + input.Rental_No.toString().leftPad(4).replaceAll(" ","0");
							}
							// Keep the property's availability in sync with its active rentals.
							// Maintenance is a manual status and is never overwritten here.
							prop = Properties[ID == input.Property];
							if(prop.count() > 0)
							{
								activeCount = Rentals[Property == input.Property && Rental_Status == "Active"].count();
								if(activeCount > 0 && prop.Availability_Status == "Available")
								{
									prop.Availability_Status = "Rented";
								}
								else if(activeCount == 0 && prop.Availability_Status == "Rented")
								{
									prop.Availability_Status = "Available";
								}
							}
							// Booking confirmation email to the customer for every new booking,
							// with a copy to the business owner.
							if(isNewBooking && input.Rental_Status == "Reserved")
							{
								guest = Customers[ID == input.Customer];
								stay = Properties[ID == input.Property];
								if(guest.count() > 0 && stay.count() > 0)
								{
									body = "<p>Dear " + guest.Customer_Name + ",</p>";
									body = body + "<p>Thank you for booking with Coastline Stays. Your reservation is confirmed:</p>";
									body = body + "<table cellpadding='6' style='border-collapse:collapse'>";
									body = body + "<tr><td><b>Reference</b></td><td>" + input.Rental_Reference + "</td></tr>";
									body = body + "<tr><td><b>Property</b></td><td>" + stay.Property_Name + "</td></tr>";
									body = body + "<tr><td><b>Check-in</b></td><td>" + input.Start_Date.toString("EEEE, dd MMMM yyyy") + "</td></tr>";
									body = body + "<tr><td><b>Check-out</b></td><td>" + input.End_Date.toString("EEEE, dd MMMM yyyy") + "</td></tr>";
									body = body + "<tr><td><b>Nights</b></td><td>" + input.Number_of_Days + " x $" + input.Daily_Rate + "</td></tr>";
									body = body + "<tr><td><b>Total</b></td><td><b>$" + input.Total_Cost + "</b></td></tr>";
									body = body + "</table>";
									body = body + "<p>If your plans change, just reply to this email and we will update or cancel the booking.</p>";
									body = body + "<p>Coastline Stays</p>";
									sendmail
									[
										from :zoho.adminuserid
										to :guest.Email
										cc :zoho.adminuserid
										subject :"Booking confirmed: " + input.Rental_Reference + " - " + stay.Property_Name
										message :body
									]
								}
							}
						)
					}
				}

			}
			Property_Validation as "Property - Validate"
			{
				type =  form
				form = Properties
				record event = on add or edit

				on validate
				{
					actions
					{
						custom deluge script
						(
							// Properties - On Validate (add and edit).
							errors = List();
							if(input.Daily_Rate == null || input.Daily_Rate <= 0)
							{
								errors.add("Daily rental rate must be greater than zero.");
							}
							else if(input.Daily_Rate > 100000)
							{
								errors.add("Daily rental rate cannot exceed 100,000.");
							}
							activeCount = Rentals[Property == ifnull(input.ID,0) && Rental_Status == "Active"].count();
							if(activeCount > 0 && input.Availability_Status != "Rented")
							{
								errors.add("This property has an active rental, so its status stays Rented until the rental is completed.");
							}
							if(activeCount == 0 && input.Availability_Status == "Rented")
							{
								errors.add("Rented is set automatically when a rental becomes Active. Choose Available or Maintenance.");
							}
							if(errors.size() > 0)
							{
								alert errors.toString("\n");
								cancel submit;
							}
						)
					}
				}

			}
		}
		}
